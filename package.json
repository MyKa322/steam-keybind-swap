{
  "name": "steam-keybind-swap",
  "version": "1.0.0",
  "description": "Перенос игровых биндов и настроек между аккаунтами Steam (Dota 2, CS2)",
  "main": "./out/main/index.js",
  "author": "MyKa322",
  "license": "MIT",
  "private": true,
  "type": "module",
  "homepage": "https://github.com/MyKa322/steam-keybind-swap",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MyKa322/steam-keybind-swap.git"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && electron-vite build",
    "preview": "electron-vite preview",
    "dist": "npm run build && electron-builder --win",
    "check:steam": "tsx --tsconfig tsconfig.node.json scripts/check-real-steam.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsx": "^4.23.9",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^4.1.10",
    "zustand": "^5.0.14"
  }
}
